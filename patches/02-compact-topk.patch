+bool llm_graph_context::use_compact_draft_topk() const {
+    if (!cparams.draft_compact_topk || !vsub || !res->t_logits_compact ||
+        res->t_logits != res->t_logits_mapped || ubatch.n_tokens != 1 || n_outputs != 1 ||
+        ubatch.n_seq_id[0] != 1 || !ubatch.output[0] || samplers.size() != 1 ||
+        cparams.n_outputs_max_per_seq != 1) {
+        return false;
+    }
+    const auto it = samplers.find(ubatch.seq_id[0][0]);
+    if (it == samplers.end() || std::strcmp(llama_sampler_name(it->second), "chain") != 0 ||
+        llama_sampler_chain_n(it->second) != 1) {
+        return false;
+    }
+    return std::strcmp(llama_sampler_name(llama_sampler_chain_get(it->second, 0)), "+top-k") == 0;
+}
