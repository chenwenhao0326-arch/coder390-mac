-static int run_type(ggml_type head_type, bool metal_mapped) {
+struct sampling_trace {
+    int full_fill = 0;
+    int full_scatter = 0;
+    int64_t topk_width = 0;
+};
+
+static bool trace_sampling(ggml_tensor * tensor, bool ask, void * userdata) {
+    if (!ask) {
+        return true;
+    }
+    auto & trace = *static_cast<sampling_trace *>(userdata);
+    if (tensor->flags & GGML_TENSOR_FLAG_COMPUTE) {
+        trace.full_fill += std::strcmp(tensor->name, "draft_full_fill") == 0;
+        trace.full_scatter += std::strcmp(tensor->name, "draft_full_scatter") == 0;
+        if (tensor->op == GGML_OP_TOP_K) {
+            trace.topk_width = tensor->src[0]->ne[0];
+        }
+    }
+    return false;
+}
+
+static int run_compact_sampling(llama_model * model, const std::vector<llama_token> & list, bool ties) {
+    llama_context * contexts[2] = { nullptr, nullptr };
+    llama_sampler * chains[2] = { nullptr, nullptr };
+    sampling_trace traces[2];
+    const char * saved = std::getenv("LLAMA_DRAFT_COMPACT_TOPK");
+    const std::string original_env = saved ? saved : "";
+    const bool had_env = saved != nullptr;
+    int n_fail = 0;
+    std::set<llama_token> valid(list.begin(), list.end());
+    valid.insert(eos);
+    for (int side = 0; side < 2; ++side) {
+        setenv("LLAMA_DRAFT_COMPACT_TOPK", side ? "1" : "0", 1);
+        auto cp = llama_context_default_params();
+        cp.n_ctx = 64;
+        cp.n_batch = cp.n_ubatch = 8;
+        cp.n_outputs_max_per_seq = 1;
+        cp.vocab_subset = list.data();
+        cp.n_vocab_subset = list.size();
+        cp.cb_eval = trace_sampling;
+        cp.cb_eval_user_data = &traces[side];
+        contexts[side] = llama_init_from_model(model, cp);
+        if (!contexts[side]) {
+            ++n_fail;
+            break;
+        }
+        chains[side] = llama_sampler_chain_init(llama_sampler_chain_default_params());
+        llama_sampler_chain_add(chains[side], llama_sampler_init_top_k(10));
+        if (!llama_set_sampler(contexts[side], 0, chains[side])) {
+            ++n_fail;
+            break;
+        }
+    }
+    if (had_env) {
+        setenv("LLAMA_DRAFT_COMPACT_TOPK", original_env.c_str(), 1);
+    } else {
+        unsetenv("LLAMA_DRAFT_COMPACT_TOPK");
+    }
+    llama_pos pos = 0;
+    // A two-token input with one output takes the compatibility path.
+    for (int step = 0; step < 3 && n_fail == 0; ++step) {
+        const int n_tokens = step == 2 ? 2 : 1;
+        llama_batch batch = llama_batch_init(n_tokens, 0, 1);
+        batch.n_tokens = n_tokens;
+        for (int i = 0; i < n_tokens; ++i) {
+            batch.token[i] = (7919*(pos + i) + 13) % n_vocab;
+            batch.pos[i] = pos + i;
+            batch.n_seq_id[i] = 1;
+            batch.seq_id[i][0] = 0;
+            batch.logits[i] = i == n_tokens - 1;
+        }
+        std::vector<llama_token> ids[2];
+        std::vector<float> values[2];
+        for (int side = 0; side < 2; ++side) {
+            traces[side] = {};
+            if (llama_decode(contexts[side], batch) != 0) {
+                ++n_fail;
+                break;
+            }
+            const auto n = llama_get_sampled_logits_count_ith(contexts[side], n_tokens - 1);
+            const auto * logits = llama_get_sampled_logits_ith(contexts[side], n_tokens - 1);
+            const auto * tokens = llama_get_sampled_candidates_ith(contexts[side], n_tokens - 1);
+            if (n != 10 || !logits || !tokens) {
+                ++n_fail;
+                break;
+            }
+            ids[side].assign(tokens, tokens + n);
+            values[side].assign(logits, logits + n);
+            const bool fast = side == 1 && n_tokens == 1;
+            if (traces[side].topk_width != (fast ? (int64_t) valid.size() : n_vocab) ||
+                (fast && (traces[side].full_fill || traces[side].full_scatter)) ||
+                (!fast && (!traces[side].full_fill || !traces[side].full_scatter))) {
+                fprintf(stderr, "compact graph mismatch: side=%d step=%d width=%" PRId64 " fill=%d scatter=%d\n",
+                        side, step, traces[side].topk_width, traces[side].full_fill, traces[side].full_scatter);
+                ++n_fail;
+            }
+            std::set<llama_token> unique(ids[side].begin(), ids[side].end());
+            if (unique.size() != 10) {
+                ++n_fail;
+            }
+            for (size_t i = 0; i < n; ++i) {
+                if (!valid.count(ids[side][i]) || !std::isfinite(values[side][i]) || (ties && values[side][i] != 0.0f)) {
+                    ++n_fail;
+                }
+            }
+        }
+        if (!ties && n_fail == 0 && (ids[0] != ids[1] || values[0] != values[1])) {
+            fprintf(stderr, "compact candidate IDs or logits differ for non-tied scores\n");
+            ++n_fail;
+        }
+        llama_batch_free(batch);
+        pos += n_tokens;
+    }
+    for (int side = 0; side < 2; ++side) {
+        if (contexts[side]) {
+            llama_set_sampler(contexts[side], 0, nullptr);
+        }
+        llama_sampler_free(chains[side]);
+        llama_free(contexts[side]);
+    }
+    fprintf(stderr, "compact sampling: ties=%d failures=%d\n", ties, n_fail);
+    return n_fail;
+}
