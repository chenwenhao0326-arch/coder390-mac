+// token ids of --spec-draft-vocab: a JSON array of integers or one id per line, range checks are done by the context
+static bool common_speculative_load_vocab(const std::string & path, std::vector<llama_token> & ids, std::string & err) {
+    std::ifstream f(path, std::ios::binary | std::ios::ate);
+    if (!f) {
+        err = "cannot open the file";
+        return false;
+    }
+    const std::streamoff size = f.tellg();
+    if (size <= 0 || size > 16*1024*1024) {
+        err = "file must contain between 1 byte and 16 MiB";
+        return false;
+    }
+    std::string text((size_t) size, '\0');
+    f.seekg(0);
+    if (!f.read(&text[0], size)) {
+        err = "cannot read the file";
+        return false;
+    }
+    for (char & c : text) {
+        if (c == '[' || c == ']' || c == ',') {
+            c = ' ';
+        }
+    }
+
+    std::istringstream ss(text);
+    std::string tok;
+    while (ss >> tok) {
+        char * end = nullptr;
+        errno = 0;
+        const long v = std::strtol(tok.c_str(), &end, 10);
+        if (errno == ERANGE || end == tok.c_str() || *end != '\0' || v < 0 || v > INT32_MAX) {
+            err = "'" + tok.substr(0, 64) + "' is not a token id";
+            return false;
+        }
+        ids.push_back((llama_token) v);
+    }
+    if (ids.empty()) {
+        err = "the list is empty";
+        return false;
+    }
+    return true;
+}
